+# Cost model. SUBSTRATE.md section 8. v0.1 placeholders, to be revised
+# against live ETF data. Owner-only.
+params_version: "0.3.0"
+
+# net = gross - turnover * half_spread - annual_fee_tracking / weeks_per_year
+application:
+  weeks_per_year: 52
+  report: net_only
+  store_gross_for_diagnostics: true
+
+buckets:
+  low:
+    label: "Treasuries, T-bills, US large-cap equity"
+    half_spread_bps: 5
+    annual_fee_tracking_bps: 5
+  mid:
+    label: "IG credit, sectors, DM regions, styles"
+    half_spread_bps: 10
+    annual_fee_tracking_bps: 15
+  high:
+    label: "HY, EM equity and debt, loans, real assets"
+    half_spread_bps: 20
+    annual_fee_tracking_bps: 35
+
+# An instrument with no bucket in the universe map is charged the most
+# expensive bucket. Costing an unmapped instrument cheaply would flatter it.
+# See decisions/proposed/0002.
+default_bucket: high
