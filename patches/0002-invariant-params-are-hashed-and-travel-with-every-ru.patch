diff --git a/params/agents.yaml b/params/agents.yaml
new file mode 100644
index 0000000..4f55568
--- /dev/null
+++ b/params/agents.yaml
@@ -0,0 +1,42 @@
+# Agent budgets and quotas. SUBSTRATE.md section 14. Owner-only.
+#
+# SUBSTRATE requires hard ceilings but does not state numbers, and inventing a
+# threshold is forbidden (KICKOFF "How to work"). Every unset ceiling below is
+# null, and the wrapper REFUSES to make a model call while its ceiling is null.
+# Fail-closed, not fail-open. See decisions/proposed/0007 for the numbers needed.
+params_version: "0.3.0"
+
+budgets:
+  tokens_per_run: null
+  tokens_per_cycle: null
+  on_breach: kill            # section 14: "kills on breach, it does not warn"
+  on_unset: refuse
+  owner_to_confirm: [tokens_per_run, tokens_per_cycle]
+
+quotas:
+  max_proposals_per_family_per_cycle: null
+  max_refinement_rounds_per_proposal: null
+  novel_provenance_per_cycle: null       # section 7: novel is quota-limited
+  owner_to_confirm:
+    - max_proposals_per_family_per_cycle
+    - max_refinement_rounds_per_proposal
+    - novel_provenance_per_cycle
+
+models:
+  # section 14 model tiering. No model id is guessed.
+  cheap: null                # config generation, result parsing, digest writing
+  expensive: null            # hypothesis generation, failure diagnosis
+  owner_to_confirm: [cheap, expensive]
+
+pricing:
+  # Needed for runs.cost_usd. Unset means cost_usd is recorded as NULL rather
+  # than as a made-up number.
+  currency: USD
+  per_million_tokens: {}
+  owner_to_confirm: [per_million_tokens]
+
+policy:
+  agents_read_summary_statistics_only: true   # section 14: never raw return panels
+  prompt_cache: [SUBSTRATE.md, params/, data/universe/]
+  log_cost_per_run: true
+  log_cost_per_accepted_idea: true
