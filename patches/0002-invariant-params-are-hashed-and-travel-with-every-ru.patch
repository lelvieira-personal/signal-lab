+    coverage: data/universe/fred_coverage.csv
+  eodhd:
+    kind: http
+    enabled: false          # not used by the lab; listed so its absence is explicit
+    base_url: "https://eodhd.com/api/"
+    env_keys: ["EODHD_API_KEY"]
+  jpmaqs:
+    kind: http
+    enabled: false          # SUBSTRATE section 5.6, pending
+    base_url: null
+    env_keys: ["JPMAQS_CLIENT_ID", "JPMAQS_CLIENT_SECRET"]
+
+reference_resolver:
+  # SUBSTRATE section 7: the harness fetches a `literature` reference and rejects
+  # the hypothesis if it cannot be resolved. No resolver host is allowlisted yet,
+  # so `literature` provenance is rejected until the owner enables one.
+  enabled: false
+  allowed_hosts: []           # e.g. ["doi.org"] once the owner approves
+  env_keys: []
