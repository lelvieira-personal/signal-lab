{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make governance)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make holdout)",
      "Bash(make audit)",
      "Bash(make audit-lean)",
      "Bash(make report)",
      "Bash(make universe)",
      "Bash(make coverage)",
      "Bash(make digest)",
      "Bash(scripts/unattended.sh:*)",
      "Bash(bash scripts/unattended.sh:*)",
      "Bash(uv run --python 3.12 --group dev:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git am:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/git_key)",
      "Read(/git_key.pub)",
      "Read(/data/raw/**)",
      "Read(/data/snapshots/**)",
      "Edit(/SUBSTRATE.md)",
      "Edit(/params/**)",
      "Edit(/vetoes/**)",
      "Write(/SUBSTRATE.md)",
      "Write(/params/**)",
      "Write(/vetoes/**)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git config:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(make lock)",
      "Bash(make clean)"
    ]
  }
}
