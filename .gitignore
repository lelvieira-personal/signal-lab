# Vendor pulls and derived panels are never committed. They are regenerable
# or re-pullable; committing them would put licensed data in git history.
data/raw/
data/snapshots/
results/artifacts/
# Regenerable: decisions/0023
results/audit/
# Regenerable: HANDOFF task 34
results/fdr_vs_fwer/
# Regenerable model output: HANDOFF task 45
results/measurement/*/loadings.parquet
# Written by `make inspect-raw`; raw_meta.json holds rows read from the vendor workbook
data/universe/raw_meta.json
data/universe/raw_structure.json
results/audit-bloomberg.log
# Weekly returns are vendor data: HANDOFF task 48
results/measurement/*/predicted_vs_actual.html
results/*.db
results/*.db-journal

# Copyrighted reference material (journal article PDFs): kept locally for the
# implementer, not redistributed via git (HANDOFF task 38).
docs/references/*.pdf

# Secrets come from environment variables only. Nothing key-shaped is tracked.
*key*
*.secret
.env
.env.*

# Build and tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Rendered reports are build output
render/*.html
leaderboard*.html

# Never committed: patch bundles used to ferry changes onto this machine, IDE
# state, and the desktop app's scratch folder. Keeps `git status` honest.
patches/
.idea/
Claude outputs/
Makefile.bak
